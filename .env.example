# =========================================================================
# GNG Corporation Website - Environment Variables Configuration Template
# =========================================================================
#
# Copy this file to a new file named '.env' locally to run the serverless
# endpoints locally using the Vercel CLI (vercel dev).
# Configure these variables in your Vercel Dashboard for production deployment.

# 1. Supabase Backend Connection
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-publishable-key-here

# 2. Secure Admin Panel Login Credentials
ADMIN_EMAIL=your-admin-email@gmail.com
ADMIN_PASSWORD=your-secure-admin-password-here
ADMIN_SESSION_SECRET=choose-a-long-random-string-to-sign-tokens-here

# 3. Optional: GitHub Deployment Script Token
# Only needed locally to run push.bat or pusher.js
GITHUB_TOKEN=your-github-personal-access-token-here
